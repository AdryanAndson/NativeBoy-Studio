    m.pc = (u16)(pc + 2); m.tick(8); m.a = rd(m, (u16)(0xFF00 | n8)); m.tick(4); return;
  }
  case 0xF1: { // pop af
    
    m.pc = (u16)(pc + 1); SET_AF(pop16(m)); m.tick(12); return;
  }
  case 0xF2: { // ldh a, [c]
    
    m.pc = (u16)(pc + 1); m.tick(4); m.a = rd(m, (u16)(0xFF00 | m.c)); m.tick(4); return;
  }
  case 0xF3: { // di
    
    m.pc = (u16)(pc + 1); m.ime = false; m.ei_delay = 0; m.tick(4); return;
  }
  case 0xF4: { // db ${op}
    
    m.locked = true; m.tick(4); return;
  }
  case 0xF5: { // push af
    
    m.pc = (u16)(pc + 1); push16(m, AF); m.tick(16); return;
  }
  case 0xF6: { // or a, {n8}
    const u8 n8 = rd(m, (u16)(pc + 1)); const s8 e8 = (s8)n8; (void)e8; (void)n8; 
    m.pc = (u16)(pc + 2); alu_or(m, n8); m.tick(8); return;
  }
  case 0xF7: { // rst $30
    
    push16(m, (u16)(pc + 1)); m.pc = 0x0030; m.tick(16); return;
  }
  case 0xF8: { // ld hl, sp {spe}
    const u8 n8 = rd(m, (u16)(pc + 1)); const s8 e8 = (s8)n8; (void)e8; (void)n8; 
    m.pc = (u16)(pc + 2); SET_HL(sp_plus(m, e8)); m.tick(12); return;
  }
  case 0xF9: { // ld sp, hl
    
    m.pc = (u16)(pc + 1); m.sp = HL; m.tick(8); return;
  }
  case 0xFA: { // ld a, [{n16}]
    const u16 n16 = rd16(m, (u16)(pc + 1)); (void)n16; 
    m.pc = (u16)(pc + 3); m.tick(12); m.a = rd(m, n16); m.tick(4); return;
  }
  case 0xFB: { // ei
    
    m.pc = (u16)(pc + 1); if (!m.ime && !m.ei_delay) { m.ei_delay = 2; m.next_event = 0; } m.tick(4); return;
  }
  case 0xFC: { // db ${op}
    
    m.locked = true; m.tick(4); return;
  }
  case 0xFD: { // db ${op}
    
    m.locked = true; m.tick(4); return;
  }
  case 0xFE: { // cp a, {n8}
    const u8 n8 = rd(m, (u16)(pc + 1)); const s8 e8 = (s8)n8; (void)e8; (void)n8; 
    m.pc = (u16)(pc + 2); alu_cp(m, n8); m.tick(8); return;
  }
  case 0xFF: { // rst $38
    
    push16(m, (u16)(pc + 1)); m.pc = 0x0038; m.tick(16); return;
  }
  }
}
